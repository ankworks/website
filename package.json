{
  "name": "ankworks-website",
  "version": "1.0.0",
  "description": "AnkWorks Official Website - Independent Software Development Portal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "worker:dev": "npm run build && wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext ts,tsx,js,cjs,mjs --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "cf-typegen": "wrangler types --include-runtime=false",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lowlight": "^3.3.0",
    "mermaid": "^12.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.3.1",
    "wrangler": "^4.149.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankworks/website.git"
  },
  "homepage": "https://works.ankb.qzz.io",
  "bugs": {
    "url": "https://github.com/ankworks/website/issues"
  },
  "license": "MIT",
  "keywords": [
    "ankworks",
    "website",
    "react",
    "typescript",
    "cloudflare",
    "workers",
    "github-api"
  ],
  "author": "AnkWorks <admin@ankb.qzz.io>",
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
