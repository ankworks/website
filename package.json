{
  "name": "ankworks-website",
  "version": "1.0.0",
  "description": "AnkWorks Official Website - Independent Software Development Portal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx,js,jsx,json,jsonc",
    "lint:fix": "eslint . --ext ts,tsx,js,jsx,json,jsonc --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "deploy": "npm run build && wrangler pages deploy --project-name ankworks-website .vite/deploy --commit-message \"Deploy to production\" || echo 'Cloudflare deployment requires CLOUDFLARE_API_TOKEN'", 
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.3.1",
    "wrangler": "^3.24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankworks/website.git"
  },
  "homepage": "https://works.ankb.qzz.io",
  "bugs": {
    "url": "https://github.com/ankworks/website/issues"
  },
  "license": "MIT",
  "keywords": [
    "ankworks",
    "website",
    "react",
    "typescript",
    "cloudflare",
    "workers",
    "github-api"
  ],
  "author": "AnkWorks <admin@ankb.qzz.io>"
}
