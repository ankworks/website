{
  // Cloudflare Workers configuration (Wrangler 4+).
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "github",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  // Enables Worker Previews (`npx wrangler preview`), required by Workers Builds for pull requests.
  // Empty block: no preview-specific overrides; the top-level configuration applies.
  "previews": {},
  // Production custom domain. Requires the ankb.qzz.io zone in the same Cloudflare account.
  "routes": [
    {
      "pattern": "works.ankb.qzz.io",
      "custom_domain": true
    }
  ],
  "assets": {
    // Output of `vite build` (see vite.config.ts build.outDir).
    "directory": "./dist",
    // Worker binding used by src/worker/index.ts to serve static files.
    "binding": "ASSETS",
    // Unknown client-side routes (e.g. /projects) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api requests invoke the Worker; other requests are served directly from assets.
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    // The repository Forge is built from. It is excluded from Forge's own
    // listings, search, activity, and scoped API routes (404). This is a
    // presentation rule only: the repository stays public on GitHub.
    "FORGE_SELF_REPO": "website"
  }
}
